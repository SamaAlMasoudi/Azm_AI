{
  "manifest_version": 3,
  "name": "عزم - AZM AI",
  "short_name": "عزم",
  "version": "1.2.0",
  "description": "عزم - رفيقك الذكي للدراسة والتركيز.",
  "permissions": ["storage", "tabs", "webNavigation", "alarms"],
  "host_permissions": ["http://localhost:3000/*", "http://127.0.0.1:3000/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "عزم - AZM AI",
    "default_popup": "dashboard.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
